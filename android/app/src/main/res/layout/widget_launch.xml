<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next Launch"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#D8DEE9"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/widget_launch_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading..."
        android:textSize="14sp"
        android:textColor="#D8DEE9"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_provider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#B1B7BF"
        android:paddingTop="4dp" />

    <TextView
        android:id="@+id/widget_countdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="T-00:00:00:00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#5E81AC"
        android:paddingTop="12dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/widget_last_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#B1B7BF"
        android:paddingTop="8dp"
        android:gravity="end" />

</LinearLayout>
